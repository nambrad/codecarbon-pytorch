# Shared CodeCarbon settings for this repo (picked up automatically from the project folder).
# Anyone can override a value with an env var, e.g. CODECARBON_REGION=california
[codecarbon]
output_dir = results
save_to_file = true
measure_power_secs = 15
log_level = warning
# Offline mode: set location manually so no IP lookup and no GPS coords end up in the CSV
country_iso_code = USA
region = massachusetts
